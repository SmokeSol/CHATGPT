{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/",
      "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]
    },
    {
      "source": "/app",
      "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]
    }
  ],
  "rewrites": [
    {"source": "/", "destination": "/web/index.html"},
    {"source": "/app", "destination": "/web/index.html"},
    {"source": "/styles.css", "destination": "/web/styles.css"},
    {"source": "/app.js", "destination": "/web/app.js"},
    {"source": "/assets/(.*)", "destination": "/web/assets/$1"},
    {"source": "/data/(.*)", "destination": "/web/data/$1"}
  ]
}
