{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ATLAS_G0_DELIBERATION_OUTPUT_SCHEMA_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows"],
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "anonymous_election_id",
          "anonymous_territory_id",
          "condition_id",
          "batch_id",
          "weighted_archetype_id",
          "decision_sha256",
          "top_party_id",
          "runner_up_party_id",
          "top_party_probability",
          "runner_up_probability",
          "decision_margin",
          "turnout_probability",
          "participation_posture",
          "transition_type",
          "decision_certainty_band",
          "self_reported_confidence",
          "central_conflict",
          "drivers",
          "why_top_party_fr",
          "why_not_runner_up_fr",
          "turnout_deliberation_fr",
          "uncertainty_fr",
          "minimum_flip_hypothesis",
          "minimum_turnout_hypothesis",
          "observable_deliberation_summary_fr",
          "unsupported_claims_detected"
        ],
        "properties": {
          "anonymous_election_id": {"type": "string"},
          "anonymous_territory_id": {"type": "string"},
          "condition_id": {"type": "string"},
          "batch_id": {"type": "string"},
          "weighted_archetype_id": {"type": "string"},
          "decision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "top_party_id": {"type": "string"},
          "runner_up_party_id": {"type": "string"},
          "top_party_probability": {"type": "number", "minimum": 0, "maximum": 1},
          "runner_up_probability": {"type": "number", "minimum": 0, "maximum": 1},
          "decision_margin": {"type": "number", "minimum": 0, "maximum": 1},
          "turnout_probability": {"type": "number", "minimum": 0, "maximum": 1},
          "participation_posture": {"enum": ["LIKELY_ABSTAIN", "UNCERTAIN", "LIKELY_VOTE"]},
          "transition_type": {"enum": ["LOYALTY", "SWITCH", "MOBILIZATION", "ABSTENTION_CONTINUITY", "OPEN_FIELD"]},
          "decision_certainty_band": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "self_reported_confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "central_conflict": {
            "type": "object",
            "additionalProperties": false,
            "required": ["factor_a", "factor_b", "description_fr"],
            "properties": {
              "factor_a": {"type": "string"},
              "factor_b": {"type": "string"},
              "description_fr": {"type": "string", "minLength": 60, "maxLength": 600}
            }
          },
          "drivers": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["factor", "direction", "strength", "evidence_ids", "explanation_fr"],
              "properties": {
                "factor": {"type": "string"},
                "direction": {"enum": ["SUPPORTS_TOP", "SUPPORTS_RUNNER_UP", "SUPPORTS_TURNOUT", "SUPPORTS_ABSTENTION", "AMBIVALENT"]},
                "strength": {"enum": ["WEAK", "MEDIUM", "STRONG"]},
                "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
                "explanation_fr": {"type": "string", "minLength": 30, "maxLength": 360}
              }
            }
          },
          "why_top_party_fr": {"type": "string", "minLength": 60, "maxLength": 700},
          "why_not_runner_up_fr": {"type": "string", "minLength": 60, "maxLength": 700},
          "turnout_deliberation_fr": {"type": "string", "minLength": 60, "maxLength": 700},
          "uncertainty_fr": {"type": "string", "minLength": 40, "maxLength": 500},
          "minimum_flip_hypothesis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_party_id", "lever", "direction", "evidence_ids", "description_fr", "confidence"],
            "properties": {
              "target_party_id": {"type": "string"},
              "lever": {"type": "string"},
              "direction": {"enum": ["INCREASE", "DECREASE", "REMOVE", "SWAP"]},
              "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
              "description_fr": {"type": "string", "minLength": 50, "maxLength": 500},
              "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]}
            }
          },
          "minimum_turnout_hypothesis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "lever", "direction", "evidence_ids", "description_fr", "confidence"],
            "properties": {
              "target": {"enum": ["MOBILIZE", "DEMOBILIZE"]},
              "lever": {"type": "string"},
              "direction": {"enum": ["INCREASE", "DECREASE", "REMOVE"]},
              "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
              "description_fr": {"type": "string", "minLength": 50, "maxLength": 500},
              "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]}
            }
          },
          "observable_deliberation_summary_fr": {"type": "string", "minLength": 120, "maxLength": 1200},
          "unsupported_claims_detected": {"const": false}
        }
      }
    }
  }
}
