    "regional_12": ["party vote-share distributions", "party P(seats=k)", "expected seats", "credible intervals"],
    "national_395": ["joint party seat-total distributions", "expected seats", "credible intervals"],
    "diagnostics": ["N uncertainty sensitivity", "Monte Carlo error", "probability normalization", "legal allocation failures", "known-data anomalies"]
