<!DOCTYPE html><html lang="fr" dir="ltr" data-critters-container><head>
  <meta charset="utf-8">
  <base href="/">
  <title>SNRTnews - Actualité du Maroc : politique, sport et culture</title>
  <meta name="description" content="SNRT News : retrouvez toute l'actualité du Maroc et du monde avec des informations fiables, des vidéos, reportages, analyses, actualités politiques, économiques, sportives et culturelles, mises à jour en continu.">
  <meta name="robots" content="index, follow">
  <link rel="alternate" type="text/plain" href="/llms.txt" title="AI Crawler Guide">
  <meta property="og:site_name" content="SNRT News">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://snrtnews.com">
  <meta property="og:title" content="SNRTnews - Actualité du Maroc : politique, sport et culture">
  <meta property="og:description" content="SNRT News : retrouvez toute l'actualité du Maroc et du monde avec des informations fiables, des vidéos, reportages, analyses, actualités économiques, sportives, culturelles et politiques, mises à jour en continu.">
  <meta property="og:image" content="https://snrtnews.com/assets/Images/snrt-news-meta-share.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="SNRTnews - Actualité du Maroc : politique, sport et culture">
  <meta name="twitter:description" content="SNRT News : actualités du Maroc, événements, vidéos et contenus éditoriaux.">
  <meta name="twitter:image" content="https://snrtnews.com/assets/Images/snrt-news-meta-share.jpg">
  <meta name="theme-color" content="#b4141e">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Preconnect : origines du chemin critique (API + CDN images). Botola / FO : chargés après LCP → dns-prefetch seulement. -->
  <link rel="preconnect" href="https://snrtnews.com" crossorigin>
  <link rel="preconnect" href="https://api.snrtnews.com" crossorigin>
  <link rel="preconnect" href="https://cdn.snrtnews.com" crossorigin>
  <link rel="dns-prefetch" href="https://api.snrtnews.com">
  <link rel="dns-prefetch" href="https://api.snrtbotola.ma">
  <link rel="dns-prefetch" href="https://cdn.snrtbotola.ma">
  <link rel="dns-prefetch" href="https://widget.snrtnews.com">
  <link rel="dns-prefetch" href="https://www.youtube.com">
  <link rel="dns-prefetch" href="https://i.ytimg.com">
  <link rel="preconnect" href="https://imasdk.googleapis.com" crossorigin>
  <!-- Nav logo is always above fold — preload eliminates one render-blocking image request -->
  <link rel="preload" href="assets/icons/logo-snrtnews.svg" as="image" type="image/svg+xml" fetchpriority="high">
  <!-- Fonts: preload WOFF2 (−52 % vs OTF) — priorité haute pour éviter le FOIT/CLS -->
  <link rel="preload" href="assets/fonts/Averta/Averta-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="assets/fonts/Averta/Averta-Semibold.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="assets/fonts/Averta/Averta-Bold.woff2" as="font" type="font/woff2" crossorigin>
  <!-- Averta-Black (weight 900) utilisée sur le rendu initial : nav, sidebar, flash-news, article-carousel -->
  <link rel="preload" href="assets/fonts/Averta/Averta-Black.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="icon" type="image/x-icon" href="assets/icons/favicon-snrt.webp">
  <link rel="icon" type="image/svg+xml" href="assets/icons/logo-snrtnews.svg" sizes="any">
  <!-- GPT : chargé après 1ère interaction utilisateur (ou 5s max) pour réduire le TBT.
       window.__snrtLoadGpt() est exposé pour que les composants Angular puissent déclencher
       le chargement dès qu'une annonce doit s'afficher, sans attendre le timeout de 5s. -->
  <script type="a0844d939f45b4b9da060cf8-text/javascript">
    window.googletag = window.googletag || {cmd: []};
    (function() {
      var loaded = false;
      function loadGPT() {
        if (loaded) return;
        loaded = true;
        var s = document.createElement('script');
        s.src = 'https://securepubads.g.doubleclick.net/tag/js/gpt.js';
        s.async = true;
        s.crossOrigin = 'anonymous';
        document.head.appendChild(s);
      }
      window.__snrtLoadGpt = loadGPT;
      ['mousemove', 'scroll', 'touchstart', 'keydown'].forEach(function(e) {
        window.addEventListener(e, loadGPT, { once: true, passive: true });
      });
      setTimeout(loadGPT, 5000);
    })();
  </script>
  <!-- Applique lang/dir immédiatement depuis localStorage pour éviter le flash RTL (repaint arabe) -->
  <script type="a0844d939f45b4b9da060cf8-text/javascript">
    (function() {
      try {
        var lang = localStorage.getItem('lang');
        if (lang === 'ar') {
          document.documentElement.setAttribute('lang', 'ar');
          document.documentElement.setAttribute('dir', 'rtl');
        }
      } catch(e) {}
    })();
  </script>
  <!-- Script pour appliquer le thème avant le rendu (état persisté du store) et éviter le flash -->
  <script type="a0844d939f45b4b9da060cf8-text/javascript">
    (function () {
      var STORAGE_KEY = '__snrt_news_storage__';
      var HEADER_COLOR_KEY = 'snrt-header-color';
      var HOME_ACCENT = '#CC0000'; /* WCAG AA: ratio 5.9:1 avec blanc (était #FF0000 = 4:1, insuffisant) */
      var DEFAULT_HEADER = '#b4141e';
      var IA_HEADER = '#212529';
      /* Aligné sur SNRT_CATEGORY_HEADER_ROUTE_TABLE (header-color-bootstrap.ts) */
      var CATEGORY_PATHS = [
        '/questions', '/videos', '/live', '/fast', '/meteo', '/filterSearch',
        '/contact', '/qui-somme-nous', '/charte-editoriale', '/politique-confidentialite'
      ];
      var HEADER_CSS_VARS = ['--snrt-header-bg', '--snrt-progress-bg', '--snrt-ticker-label-bg'];

      function safeParse(raw) {
        try {
          return raw ? JSON.parse(raw) : null;
        } catch (e) {
          return null;
        }
      }

      function normalizePath(path) {
        return path.length > 1 && path.charAt(path.length - 1) === '/'
          ? path.slice(0, -1)
          : path;
      }

      function normalizeSlug(value) {
        return String(value || '')
          .trim()
          .replace(/&amp;/gi, '')
          .replace(/&[a-z]+;/gi, '')
          .toLowerCase()
          .replace(/-/g, ' ')
          .replace(/[^a-z0-9\u0600-\u06FF ]/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
      }

      function isHome(path) {
        return !path || path === '/' || path === '/fr' || path === '/fr/'
          || path === '/ar' || path === '/ar/';
      }

      function isCategoryHeader(path, pathNorm) {
        if (isHome(path)) {
          return true;
        }
        for (var i = 0; i < CATEGORY_PATHS.length; i++) {
          if (pathNorm === CATEGORY_PATHS[i]) {
            return true;
          }
        }
        return false;
      }

      function isDossier(path) {
        return path === '/dossier' || path === '/dossier/'
          || /\/(?:fr|ar)\/dossier[-_]?(?:du[-_])?mois\//i.test(path)
          || /^\/dossier[-_]?(?:du[-_])?mois\//i.test(path)
          || path.indexOf('dossier-detail') !== -1;
      }

      function isArticlePath(path) {
        return /\/(?:fr|ar)\/article\//.test(path)
          || /^\/article\//.test(path)
          || path === '/preview'
          || /\/preview$/.test(path);
      }

      function resolveHeaderFromState(path, state) {
        var catSlice = state && state.category;
        var categories = catSlice && catSlice.category;
        var selected = catSlice && catSlice.categorySelected;
        var article = state && state.articledetail && state.articledetail.article;

        if (article && isArticlePath(path)) {
          if (article.color) {
            return article.color;
          }
          if (article.category && Array.isArray(categories)) {
            var catLabel = String(article.category).trim().toLowerCase();
            for (var j = 0; j < categories.length; j++) {
              var catRow = categories[j];
              if (
                catRow &&
                catRow.title &&
                String(catRow.title).trim().toLowerCase() === catLabel &&
                catRow.color
              ) {
                return catRow.color;
              }
            }
          }
          return null;
        }

        if (path.indexOf('/thematique/') !== -1 && Array.isArray(categories)) {
          var slug = decodeURIComponent(path.split('/thematique/')[1].split('?')[0].split('#')[0]);
          var slugNorm = normalizeSlug(slug);
          for (var i = 0; i < categories.length; i++) {
            var cat = categories[i];
            if (cat && cat.title && normalizeSlug(cat.title) === slugNorm && cat.color) {
              return cat.color;
            }
          }
          return null;
        }

        if (selected && typeof selected === 'object' && selected.color) {
          return selected.color;
        }
        return null;
      }

      function resolveHeaderColor(path, pathNorm, state) {
        if (path.indexOf('/page-ai') !== -1) {
          return IA_HEADER;
        }
        if (isCategoryHeader(path, pathNorm)) {
          return HOME_ACCENT;
        }
        if (isDossier(path)) {
          return DEFAULT_HEADER;
        }
        var fromState = state ? resolveHeaderFromState(path, state) : null;
        if (fromState) {
          return fromState;
        }
        // Thématique sans catégorie résolue : rouge SNRT (#FF0000).
        if (path.indexOf('/thematique/') !== -1) {
          return HOME_ACCENT;
        }
        var catSliceEmpty = state && state.category;
        var selectedEmpty = !catSliceEmpty || !catSliceEmpty.categorySelected || catSliceEmpty.categorySelected === '';
        if (selectedEmpty) {
          return HOME_ACCENT;
        }
        try {
          return localStorage.getItem(HEADER_COLOR_KEY);
        } catch (e) {
          return null;
        }
      }

      function applyTheme(theme) {
        document.documentElement.setAttribute('data-bs-theme', theme);
        var favicon = document.querySelector('link[rel="icon"][type="image/svg+xml"]');
        if (favicon) {
          favicon.href = theme === 'dark'
            ? 'assets/icons/snrtlogo.svg'
            : 'assets/icons/logo-snrtnews.svg';
        }
        var setBodyTheme = function () {
          document.body.setAttribute('data-bs-theme', theme);
        };
        if (document.body) {
          setBodyTheme();
        } else {
          document.addEventListener('DOMContentLoaded', setBodyTheme);
        }
      }

      function applySiteHomeHeaderColors() {
        var htmlEl = document.documentElement;
        htmlEl.style.setProperty('--snrt-header-bg', HOME_ACCENT);
        htmlEl.style.setProperty('--snrt-progress-bg', HOME_ACCENT);
        htmlEl.style.setProperty('--snrt-ticker-label-bg', HOME_ACCENT);
        var themeMeta = document.querySelector('meta[name="theme-color"]');
        if (themeMeta) {
          themeMeta.setAttribute('content', HOME_ACCENT);
        }
      }

      function applyHeaderColor(color) {
        if (!color) {
          return;
        }
        var htmlEl = document.documentElement;
        for (var k = 0; k < HEADER_CSS_VARS.length; k++) {
          htmlEl.style.setProperty(HEADER_CSS_VARS[k], color);
        }
        var themeMeta = document.querySelector('meta[name="theme-color"]');
        if (themeMeta) {
          themeMeta.setAttribute('content', color);
        }
      }

      try {
        var savedState = safeParse(localStorage.getItem(STORAGE_KEY));
        var theme = savedState && savedState.theme && savedState.theme.theme === 'dark'
          ? 'dark'
          : 'light';
        applyTheme(theme);

        var path = location.pathname || '/';
        var pathNorm = normalizePath(path);
        if (isCategoryHeader(path, pathNorm)) {
          applySiteHomeHeaderColors();
        } else {
          applyHeaderColor(resolveHeaderColor(path, pathNorm, savedState));
        }
      } catch (e) {
        document.documentElement.setAttribute('data-bs-theme', 'light');
        if (document.body) {
          document.body.setAttribute('data-bs-theme', 'light');
        }
      }
    })();
  </script>
  <!-- CSS critique minimal : thème + éviter flash layout avant Bootstrap (FCP). -->
  <style>
    html {
      -webkit-text-size-adjust: 100%;
    }

    body {
      margin: 0;
    }

    html[data-bs-theme="dark"],
    html[data-bs-theme="dark"] body {
      background-color: #000;
      color: #fff;
    }
  </style>
