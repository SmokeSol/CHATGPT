changent, mais les tentatives marocaines pour reprendre Sebta, Melilla et les présides occupés de la côte se succèdent."},"display_date":"2026-08-15T11:00:00Z","distributor":{"category":"staff","name":"le360","subcategory":""},"headlines":{"basic":"Sebta et Melilla: conquises, jamais abandonnées","meta_title":"","mobile":"","native":"","print":"","table":"","tablet":"","web":""},"label":{"afficher_le_chapo_sur_mobile":{"display":true,"text":"Non","url":""},"papier_urgent":{"display":true,"text":"Non","url":""}},"language":"FR","owner":{"sponsored":false},"promo_items":{"basic":{"_id":"M4KJTNTUINB5PHCWEXDTZ6JVJY","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/M4KJTNTUINB5PHCWEXDTZ6JVJY.jpg?auth=bd7ca83cff0c2318409a19a31aa8a5d608a7313f2bd0dc4e178663a92107c04b","galleries":[],"ingestionMethod":"manual","mime_type":"image/jpeg","originalName":"GBRLTTB2PVDPLKC75PTMOBR6WY.jpg","originalUrl":"https://cloudfront-eu-central-1.images.arcpublishing.com/le360/M4KJTNTUINB5PHCWEXDTZ6JVJY.jpg","owner":"hsmyej@le360.ma","proxyUrl":"/resizer/v2/M4KJTNTUINB5PHCWEXDTZ6JVJY.jpg?auth=bd7ca83cff0c2318409a19a31aa8a5d608a7313f2bd0dc4e178663a92107c04b","published":true,"resizeUrl":"/resizer/v2/M4KJTNTUINB5PHCWEXDTZ6JVJY.jpg?auth=bd7ca83cff0c2318409a19a31aa8a5d608a7313f2bd0dc4e178663a92107c04b","restricted":false,"thumbnailResizeUrl":"/resizer/v2/M4KJTNTUINB5PHCWEXDTZ6JVJY.jpg?auth=bd7ca83cff0c2318409a19a31aa8a5d608a7313f2bd0dc4e178663a92107c04b&width=300","version":0,"template_id":276},"address":{},"auth":{"1":"bd7ca83cff0c2318409a19a31aa8a5d608a7313f2bd0dc4e178663a92107c04b"},"caption":"Mouna Hachim.","created_date":"2024-11-09T09:11:22Z","credits":{"affiliation":[{"name":"Le360","type":"author"}]},"height":1355,"image_type":"photograph","last_updated_date":"2024-11-09T09:11:22Z","licensable":false,"owner":{"id":"le360","sponsored":false},"source":{"additional_properties":{"editor":"photo center"},"edit_url":"","system":"photo center"},"subtitle":"Mouna Hachim New","taxonomy":{"