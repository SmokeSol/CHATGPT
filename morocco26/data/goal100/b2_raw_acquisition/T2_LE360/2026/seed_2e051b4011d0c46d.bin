"displayProperties":{},"localEdits":{},"variants":{}}},{"collection":"features","type":"header/index","props":{"collection":"features","type":"header/index","id":"f0fMSauOF4gw2Ea","name":"Header principal","contentConfig":{"contentService":"","contentConfigValues":{},"inherit":true},"customFields":{"languageTitle":"Español","languageLink":"https://es.le360.ma/","listContentConfig":{"contentService":"site-service-hierarchy","contentConfigValues":{"hierarchy":"menu-principal"}},"listCountryContentConfig":{"contentService":"site-service-hierarchy","contentConfigValues":{"sectionId":"","hierarchy":"menu-country"}},"secondLanguageTitle":"Anglais","secondLanguageLink":"https://en.le360.ma/","thirdLanguageLink":"https://ar.le360.ma/","thirdLanguageTitle":"العربية"},"displayProperties":{},"localEdits":{},"variants":{}}},{"collection":"features","type":"headerMenuBar/default","props":{"collection":"features","type":"headerMenuBar/default","id":"f0fmFA78JUVi4HM","name":"Menu Actuellement - Le360","contentConfig":{"contentService":"","contentConfigValues":{},"inherit":true},"customFields":{"listContentConfig":{"contentService":"site-service-hierarchy","contentConfigValues":{"hierarchy":"menu-principal"}}},"displayProperties":{},"localEdits":{},"variants":{}}},{"collection":"features","type":"htmlbox/default","props":{"collection":"features","type":"htmlbox/default","id":"f0fGnYqASptP4ns","name":"Scripts - Le360 REDA","contentConfig":{"contentService":"","contentConfigValues":{},"inherit":true},"customFields":{"HTML":"<script>\nconsole.log('V1.3 - le360');\n  // Fonction pour enregistrer la position du scroll dans le stockage local avec une expiration de 15 minutes\n  function enregistrerPositionScroll(articleId) {\n    const expirationTime = Date.now() + 15 * 60 * 1000; // 15 minutes en millisecondes\n    const data = {\n      position: window.pageYOffset,\n      expiration: expirationTime\n    };\n    localStorage.setItem(`positionScroll_${articleId}`, JSON.stringify(data));\n    console.log('Position du scroll enregistrée pour l\\'article ' + articleId);\n  }\n\n  // Fonction pour restaurer la position du scroll depuis le stockage local et supprimer l'entrée\n  function restaurerPositionScroll(articleId) {\n    console.log('Restauration de la position du scroll...');\n    const storedData = localStorage.getItem(`positionScroll_${articleId}`);\n    if (storedData) {\n      const data = JSON.parse(storedData);\n      if (data.expiration >= Date.now()) {\n        window.scrollTo(0, parseInt(data.position));\n        console.log('Position du scroll restaurée.');\n      } else {\n        console.log('L\\'entrée a expiré.');\n      }\n      // Supprimer l'entrée après avoir restauré la position\n      localStorage.removeItem(`positionScroll_${articleId}`);\n      console.log('Entrée supprimée du localStorage.');\n    } else {\n      console.log('Aucune position du scroll enregistrée.');\n    }\n  }\n\n  // Fonction pour nettoyer les enregistrements expirés (plus de 15 minutes)\n  function nettoyerEnregistrementsExpires() {\n    console.log('Nettoyage des enregistrements expirés...');\n    const keysToRemove = [];\n    for (let i = 0; i < localStorage.length; i++) {\n      const key = localStorage.key(i);\n      if (key.startsWith('positionScroll_')) {\n        const data = JSON.parse(localStorage.getItem(key));\n        if (data && data.expiration < Date.now()) {\n          keysToRemove.push(key);\n        }\n      }\n    }\n\n    // Supprimer les enregistrements expirés\n    keysToRemove.forEach(key => {\n      localStorage.removeItem(key);\n      console.log(`Entrée expirée supprimée : ${key}`);\n    });\n\n    console.log('Nettoyage terminé.');\n  }\n\n  // Appeler la fonction pour nettoyer les enregistrements expirés\n  nettoyerEnregistrementsExpires();\n\n  // Fonction pour extraire l'identifiant de l'article depuis l'URL\n  function extraireArticleId() {\n    const url = window.location.href;\n    const matches = url.split('/').filter(part => part !== ''); // Filtrer les parties vides\n\n    // Afficher les valeurs de matches dans la console\n    console.log('Valeurs de matches :', matches);\n\n    if (matches && matches.length > 2) {\n      return matches[3].split('_')[1];\n    }\n    return null;\n  }\n\n  // Utiliser la fonction pour obtenir l'identifiant de l'article\n  const articleId = extraireArticleId();\n  console.log('Identifiant de l\\'article :', articleId);\n\n  // Attendre que le DOM soit entièrement chargé\n  document.addEventListener('DOMContentLoaded', () => {\n    // Écouter l'événement de rafraîchissement de la page\n    window.addEventListener('beforeunload', () => {\n      console.log('Rafraîchissement de la page...');\n      enregistrerPositionScroll(articleId);\n      localStorage.removeItem(`positionScroll_${articleId}`);\n      console.log('Fin du rafraîchissement de la page.');\n    });\n\n    // Appeler la fonction pour restaurer la position du scroll après le chargement de la page\n    window.addEventListener('load', () => {\n      console.log('Chargement de la page terminé.');\n      restaurerPositionScroll(articleId);\n    });\n\n    // Écouter l'événement de scroll et appeler la fonction pour enregistrer la position du scroll\n    window.addEventListener('scroll', () => {\n      enregistrerPositionScroll(articleId);\n    });\n  });\n<\/script>\n\n<script src=\"https://pub.le360.ma/patch-le360.js\"><\/script>\n\n"},"displayProperties":{},"localEdits":{},"variants":{}}},{"collection":"features","type":"htmlbox/default","props":{"collection":"features","type":"htmlbox/default","id":"f0fUdbmZFqZR2Ml","name":"Le360 G","contentConfig":{"contentService":"","contentConfigValues":{},"inherit":true},"customFields":{"HTML":"\n<!-- Le360 Ads. Asynchronous JS Tag -->\n<ins data-revive-zoneid=\"371\" data-revive-id=\"98ddac4f1103620c02fb3971b1c4762f\"></ins>\n<script async src=\"//pub.le360.ma/ads360/www/delivery/asyncjs.php\"><\/script>"},"displayProperties":{},"localEdits":{},"