tique/le-dispositif-dalerte-renforce-a-fnideq-le-retour-des-migrants-de-sebta-se-poursuit_GPES6WK5MNBWVPCWNJELJW6Q54/"}},"canonical_url":"/politique/le-dispositif-dalerte-renforce-a-fnideq-le-retour-des-migrants-de-sebta-se-poursuit_GPES6WK5MNBWVPCWNJELJW6Q54/"}],"websites":{"le-360-francais":{}},"description":{"basic":"Collection des top 8 articles du 360 en Français. "},"content_aliases":["top-360-fr"],"owner":{"id":"le360"},"revision":{"branch":"default","published":true},"canonical_url":null,"publishing":{"scheduled_operations":{"publish_edition":[],"unpublish_edition":[]}},"website":"le-360-francais"},"expires":1786959642313,"lastModified":1786959342247},"{\"_id\":\"IR6GWEGGRBCQRKCVUYUT2IM3YE\"}":{"data":{"_id":"IR6GWEGGRBCQRKCVUYUT2IM3YE","version":"0.10.6","created_date":"2022-01-05T10:13:51.030Z","headlines":{"basic":"[360-FR]  Revue de Presse"},"last_updated_date":"2026-08-16T19:53:05.807Z","type":"collection","canonical_website":"le-360-francais","websites":{"le-360-francais":{}},"content_elements":[{"_id":"S7L5HQYL2ZHAVDWKD7HFXJ64I4","canonical_website":"le-360-francais","credits":{"by":[{"additional_properties":{"original":{"author_type":""}},"name":"Hassan Benadad","org":"","type":"author"}]},"description":{"basic":"\nLe nouveau dispositif de révision des prix, entré en vigueur récemment, vise à réduire le coût des traitements pour les patients en indexant les génériques sur les princeps et en accélérant les révisions triennales. Les consommateurs devront patienter : une phase transitoire d’un an est prévue avant que les nouvelles listes de prix ne s’appliquent en pharmacie. Toutefois, les pharmaciens dénoncent une réforme imposée sans véritable concertation et tirent la sonnette d’alarme sur la survie des officines de proximité et la continuité des soins. Cet article est une revue de presse tirée d’Al Ahdath Al Maghribia."},"display_date":"2026-08-16T19:53:10.066Z","distributor":{"mode":"reference","reference_id":"ee9cefa1-de4c-4a38-9f11-313a42dd5bd7"}