url":""}],"socialLinks":[{"site":"email","url":"","deprecated":true,"deprecation_msg":"Please use social_links."}],"additional_properties":{"original":{"_id":"LaRédaction","firstName":"La ","lastName":"Rédaction            ","byline":"La Rédaction","image":"","email":"","affiliations":"","education":[],"awards":[],"books":[],"podcasts":[],"bio_page":"","bio":"","longBio":"","slug":"La Rédaction","native_app_rendering":false,"fuzzy_match":false,"contributor":false,"status":true,"last_updated_date":"2025-07-07T14:07:45.221Z"}}}]},"description":{"basic":"Boosté par l'implantation des géants internationaux et d’excellentes performances sur le segment haut de gamme, le secteur hôtelier marocain vit une mutation à deux vitesses. Tandis que les grandes enseignes renforcent leurs positions à l'approche des grands rendez-vous internationaux, l'étau se resserre sur les établissements intermédiaires, confrontés à la montée en puissance de la location de courte durée et à l'urgence d'une régulation structurante. Cet article est une revue de presse tirée de Finances News Hebdo.\n"},"display_date":"2026-08-16T17:59:53.987Z","distributor":{"category":"staff","name":"le360","subcategory":""},"headlines":{"basic":"L’hôtellerie, entre essor du luxe et fracture des modèles traditionnels","meta_title":"","mobile":"","native":"","print":"","table":"","tablet":"","web":""},"label":{"afficher_le_chapo_sur_mobile":{"display":true,"text":"Non","url":""},"papier_urgent":{"display":true,"text":"Non","url":""}},"language":"FR","owner":{"sponsored":false},"promo_items":{"basic":{"_id":"ALCBHMS4JRC5LFS6BQS4ESU3RM","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/ALCBHMS4JRC5LFS6BQS4ESU3RM.jpg?auth=47aa0eb297ea0d3fc1df0a3dc81eafcd6c86ffb311bb955db7f1c1377c1b0054","galleries":[{"headlines":{"basic":"Diapo. KAAN Hotel Casablanca, une nouvelle génération d’hôtellerie lifestyle, ouvre ses portes"},"_id":"O5XT67MTCJAL5PUBUNNVOQJKWU"}],"ingestionMethod":"manual","mime_type":"image/jpeg","origi