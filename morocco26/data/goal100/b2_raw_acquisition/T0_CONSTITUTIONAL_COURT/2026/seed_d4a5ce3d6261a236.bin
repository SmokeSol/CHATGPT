<div class="last-decision-container">
    <div class="wrap-title">
        <h2 class="title">&#x642;&#x631;&#x627;&#x631;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x62D;&#x643;&#x645;&#x629; &#x627;&#x644;&#x62F;&#x633;&#x62A;&#x648;&#x631;&#x64A;&#x629;</h2>
    </div>
