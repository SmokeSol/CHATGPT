            <button class="carousel-control-next" type="button" data-bs-target="#bootstrapCarousel" data-bs-slide="next" aria-label="&#x627;&#x644;&#x646;&#x634;&#x627;&#x637; &#x627;&#x644;&#x62A;&#x627;&#x644;&#x64A;">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
