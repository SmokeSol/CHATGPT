    </div>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        var myCarousel = document.querySelector('#bootstrapCarousel');
        if (!myCarousel) return;

        var options = { interval: 4000, pause: 'hover', wrap: true };
        var carousel;

        if (bootstrap.Carousel && typeof bootstrap.Carousel.getOrCreateInstance === 'function') {
            carousel = bootstrap.Carousel.getOrCreateInstance(myCarousel, options);
        } else {
            try {
                carousel = bootstrap.Carousel.getInstance(myCarousel) || new bootstrap.Carousel(myCarousel, options);
            }
            catch (err) {
                console.error('Carousel init error', err);
                carousel = new bootstrap.Carousel(myCarousel, options);
            }
        }

        try { carousel.cycle(); } catch (err) { console.error('Carousel cycle error', err); }

        let isSliding = false;

        myCarousel.addEventListener('slide.bs.carousel', function (e) {
            if (isSliding) {
                e.preventDefault();
                return;
            }
            isSliding = true;
        });

        myCarousel.addEventListener('slid.bs.carousel', function (e) {
            isSliding = false;

            var itemsCount = myCarousel.querySelectorAll('.carousel-item').length;

            if (e.to >= 4 && itemsCount > 4) {
                carousel.pause();
                console.log("Autoplay stopped at slide index: " + e.to);
            }
            else {
                carousel.cycle();
            }
        });

        var controls = myCarousel.querySelectorAll('.carousel-control-prev, .carousel-control-next');

        controls.forEach(btn => {
            btn.addEventListener('click', function () {
                carousel.pause();
            });
        });

    });
</script>

            

