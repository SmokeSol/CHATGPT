{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"M26-ASV2-ARCHETYPE-OUTPUT-V1",
  "type":"object",
  "additionalProperties":false,
  "required":["run_id","condition_id","anonymous_election_id","anonymous_territory_id","archetype_id","packet_sha256","turnout_probability","conditional_party_probabilities","reason_codes","attempt_number"],
  "properties":{
    "run_id":{"type":"string","minLength":1},
    "condition_id":{"type":"string","enum":["AS2_LLM_INDEPENDENT_TRUE_CONTEXT","AS2_LLM_INDEPENDENT_SHUFFLED_CONTEXT"]},
    "anonymous_election_id":{"type":"string","minLength":1},
    "anonymous_territory_id":{"type":"string","minLength":1},
    "archetype_id":{"type":"string","minLength":1},
    "packet_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "turnout_probability":{"type":"number","minimum":0,"maximum":1},
    "conditional_party_probabilities":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["anonymous_party_id","probability"],
        "properties":{
          "anonymous_party_id":{"type":"string","minLength":1},
          "probability":{"type":"number","minimum":0,"maximum":1}
        }
      }
    },
    "reason_codes":{
      "type":"array","uniqueItems":true,
      "items":{"type":"string","enum":["PRIOR_VOTE_PERSISTENCE","PRIOR_ABSTENTION_PERSISTENCE","VERIFIED_CANDIDATE_CONTEXT","VERIFIED_INCUMBENCY","VERIFIED_PARTY_SWITCH","VERIFIED_ENDORSEMENT","VERIFIED_OFFICE_HOLDING","VERIFIED_ALLIANCE","VERIFIED_NEGATIVE_EVENT","PARTICIPATION_DEMOGRAPHIC_UNCERTAINTY","NO_DIRECTIONAL_CONTEXT","MISSING_CONTEXT_LIMITATION"]}
    },
    "attempt_number":{"type":"integer","minimum":1}
  },
  "semantic_validation_not_expressible_in_json_schema":[
    "conditional_party_probabilities must contain each party offered in the packet exactly once and no other party",
    "conditional party probabilities must sum to 1 within 1e-9",
    "identifier fields and packet_sha256 must exactly match the input row",
    "retries are permitted only after schema/semantic-contract invalidity with identical prompt and no semantic feedback"
  ]
}
